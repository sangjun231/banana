# ============================================================
# Terraform 변수 설정 - EC2 버전
# ============================================================
# 
# 사용 방법:
#   1. 이 파일을 복사: cp terraform.tfvars.example terraform.tfvars
#   2. terraform.tfvars에서 값 수정
#   3. terraform.tfvars는 .gitignore에 추가
# ============================================================


# ============================================================
# 공통 설정
# ============================================================

aws_region   = "ap-northeast-2"  # 서울 리전
environment  = "dev"             # dev, staging, prod
project_name = "websocket-chat"  # 리소스 이름 prefix


# ============================================================
# EC2 설정
# ============================================================

# 인스턴스 타입 (프리티어: t3.micro, t3.small, t4g.micro)
ec2_instance_type = "t3.micro"

# SSH 키 페어 이름 (AWS 콘솔에서 미리 생성 필요)
ec2_key_name = "your-key-name"

# SSH 접속 허용 IP (보안을 위해 본인 IP만 허용 권장)
# 본인 IP 확인: curl ifconfig.me
# 예: ["123.45.67.89/32"]
ssh_allowed_cidr = ["0.0.0.0/0"]

# HTTPS(nginx + certbot)용 — Cloudflare DNS에서 이 이름이 EIP로 연결되어 있어야 발급 성공
api_domain = "ex.com 등"
acme_email = "your-email@example.com"

# 운영: false (3001은 로컬만). 디버그 시에만 true
# expose_nest_port_publicly = true


# ============================================================
# 비용 관리
# ============================================================

budget_alert_email   = "your-email@example.com"
monthly_budget_limit = 10  # EC2 프리티어는 낮게 설정


# ============================================================
# VPC 설정 (선택사항 - 기본값 사용 권장)
# ============================================================

# vpc_cidr           = "10.0.0.0/16"
# availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]
